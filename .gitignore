# Photos de logements uploadées par les utilisateurs : contenu
# généré à l'exécution, pas du code source.
backend/uploads/logements/*
!backend/uploads/logements/.gitkeep
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
backend/uploads/messages/*
!backend/uploads/messages/.gitkeep

# Configuration locale de l'outil Claude Code, pas du projet.
.claude/

# Secrets réels (mot de passe d'application Gmail, identifiants
# OAuth Google, clés API PayDunya) : jamais commités, uniquement
# déployés en direct sur chaque environnement. Voir les fichiers
# .example.php.
backend/config/mail.php
backend/config/google.php
backend/config/paydunya.php

# Export des vraies données (comptes, annonces) pour migration vers
# un nouvel hébergeur : contient des mots de passe hachés et des
# numéros de téléphone, à importer directement via phpMyAdmin,
# jamais commité.
backend/install/migration/
